# Supabase Configuration
# Copy this file to .env and fill in your actual values
# Get these values from your Supabase project settings: https://supabase.com/dashboard/project/ggpxsxanqpapwyqnfivv/settings/api

VITE_SUPABASE_URL=https://ggpxsxanqpapwyqnfivv.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Plaid. Keep PLAID_SECRET on the server only — never use a VITE_ prefix.
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
# sandbox = fake test banks. production = real Revolut / Polish Open Banking.
# Live Revolut requires the Production secret from Plaid Dashboard → Keys, not the sandbox secret.
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=PL
# Required for real Revolut OAuth. Add the same URL in Plaid Dashboard → Allowed redirect URIs.
PLAID_REDIRECT_URI=https://purple5.vercel.app/banks
# Local API testing without a Supabase session (sandbox only)
# PLAID_ALLOW_UNAUTHENTICATED=true

# Gmail (Credit Agricole PDF statements). Server-only secret — never use a VITE_ prefix on GOOGLE_CLIENT_SECRET.
# Use the same Google Cloud OAuth client as Sign in with Google. Enable Gmail API.
# Add Authorized redirect URI: https://purple5.vercel.app/settings  and  http://localhost:3000/settings
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REDIRECT_URI=https://purple5.vercel.app/settings
