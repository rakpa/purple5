# Supabase Configuration
# Copy this file to .env and fill in your actual values
# Get these values from your Supabase project settings: https://supabase.com/dashboard/project/ggpxsxanqpapwyqnfivv/settings/api

VITE_SUPABASE_URL=https://ggpxsxanqpapwyqnfivv.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Plaid sandbox (Poland). Keep PLAID_SECRET on the server only — never use a VITE_ prefix.
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=PL
# Optional. Required for Polish Open Banking OAuth in Plaid Link.
# Add the same URL in Plaid Dashboard → Team Settings → Allowed redirect URIs.
# PLAID_REDIRECT_URI=http://localhost:3000/settings
# Local API testing without a Supabase session (sandbox only)
PLAID_ALLOW_UNAUTHENTICATED=true
